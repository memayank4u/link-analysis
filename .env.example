# ========================================================
# AI-Powered Website Link Analysis API Configuration
# ========================================================

# Server Configuration
HOST=0.0.0.0
PORT=4000
DEBUG=false

# LLM Provider Selection ("gemini", "openai", or "mock")
# If no API key is configured, the system falls back to an intelligent contextual mock engine.
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Recommended: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Alternative: gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=  # Optional: custom endpoint (e.g. Groq, OpenRouter, DeepSeek, Ollama)

# Scraper & Token Cost Optimization
REQUEST_TIMEOUT=15
MAX_CONTENT_LENGTH=25000

# Response Caching (Avoids repeated API costs on duplicate analyses)
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
